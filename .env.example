# Nunca agregues valores reales a este archivo.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# sandbox o production; Production Browse requiere aprobación de eBay Buy APIs.
EBAY_ENVIRONMENT=sandbox
EBAY_BUY_PRODUCTION_APPROVED=false
EBAY_GROWTH_CHECK_APPROVED=false
# Marketplace Account Deletion: deben coincidir exactamente con el portal eBay.
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=
EBAY_MARKETPLACE_DELETION_ENDPOINT_URL=
# Clave aleatoria local para HMAC de notificationId; no es el verification token.
EBAY_DELETION_IDEMPOTENCY_KEY=
EBAY_DELETION_INBOX_PATH=work/ebay_deletion.sqlite3
# Lista de raíces permitidas separadas por ':' en macOS/Linux.
EBAY_DATA_ROOTS=data
